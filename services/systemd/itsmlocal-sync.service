[Unit]
Description=Medulla itsmlocal synchronisation service
After=network-online.target mariadb.service mysql.service mmc-agent.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/itsmlocal-sync --interval 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

#. ----------------------------------------------------------------------
#. Chaines qui ne proviennent d aucun fichier PHP : contenu du catalogue
#. livre en base (libelles, descriptions, gabarits de message) et phrases
#. composees par pulse-xmpp-master-substitute, plugin reflex. Une
#. extraction automatique ne les voit pas et les marquerait obsoletes :
#. ne pas les supprimer.
#. ----------------------------------------------------------------------
msgid "CPU load"
msgstr "Charge processeur"

msgid "Overall processor usage of the machine, as a percentage."
msgstr "Utilisation globale du processeur de la machine, en pourcentage."

msgid "Memory used"
msgstr "Mémoire utilisée"

msgid "Share of physical memory in use, as a percentage."
msgstr "Part de la mémoire physique utilisée, en pourcentage."

msgid "Swap used"
msgstr "Swap utilisé"

msgid "Share of swap space in use, as a percentage."
msgstr "Part de l'espace de swap utilisé, en pourcentage."

msgid "Disk space"
msgstr "Espace disque"

msgid "Space used on each partition or volume, as a percentage."
msgstr "Espace utilisé sur chaque partition ou volume, en pourcentage."

msgid "Disk SMART status"
msgstr "État SMART du disque"

msgid "Health status reported by the disk itself."
msgstr "État de santé remonté par le disque lui-même."

msgid "Agent silent"
msgstr "Agent silencieux"

msgid "The agent has reported nothing for longer than the configured delay. The server states that measures stopped arriving; it cannot tell what the machine is doing: switched off or asleep, off the network or filtered, agent stopped or failing."
msgstr "L'agent n'a plus rien remonté depuis plus longtemps que le délai configuré. Le serveur constate que les mesures ont cessé d'arriver ; il ne peut rien déduire de l'état de la machine : éteinte ou en veille, hors du réseau ou filtrée, agent arrêté ou en échec."

msgid "Failed services"
msgstr "Services en échec"

msgid "Number of system services in a failed state."
msgstr "Nombre de services système en état d'échec."

msgid "Antivirus active"
msgstr "Antivirus actif"

msgid "Whether an antivirus protection is present and running."
msgstr "Présence et fonctionnement d'une protection antivirus."

msgid "Antivirus signature age"
msgstr "Ancienneté des signatures antivirus"

msgid "Age of the antivirus signatures, in days."
msgstr "Ancienneté des signatures de l'antivirus, en jours."

msgid "Firewall active"
msgstr "Pare-feu actif"

msgid "State of the local firewall."
msgstr "État du pare-feu local."

msgid "Disk encryption"
msgstr "Chiffrement du disque"

msgid "Encryption state of the system volume."
msgstr "État de chiffrement du volume système."

msgid "Failed logons"
msgstr "Connexions en échec"

msgid "Number of failed authentications over the last 15 minutes. The window is part of the measure: a threshold with no period behind it means nothing."
msgstr "Nombre d'authentifications en échec sur les 15 dernières minutes. La fenêtre fait partie de la mesure : un seuil sans période derrière lui ne veut rien dire."

msgid "Pending updates"
msgstr "Mises à jour en attente"

msgid "Number of system updates available."
msgstr "Nombre de mises à jour système disponibles."

msgid "Reboot required"
msgstr "Redémarrage requis"

msgid "The machine is waiting for a reboot to finish applying an update."
msgstr "La machine attend un redémarrage pour terminer l'application d'une mise à jour."

msgid "Load average"
msgstr "Charge moyenne"

msgid "System load average over the last 5 minutes, relative to the number of cores, as a percentage."
msgstr "Charge moyenne du système sur les 5 dernières minutes, rapportée au nombre de cœurs, en pourcentage."

msgid "Process count"
msgstr "Nombre de processus"

msgid "Number of processes running on the machine."
msgstr "Nombre de processus en cours d'exécution sur la machine."

msgid "Temperature"
msgstr "Température"

msgid "Highest temperature reported by the sensors of the machine."
msgstr "Température la plus élevée rapportée par les capteurs de la machine."

msgid "Local administrators"
msgstr "Administrateurs locaux"

msgid "Number of accounts that are members of the local administration group of the machine."
msgstr "Nombre de comptes membres du groupe d'administration locale de la machine."

msgid "Name resolution"
msgstr "Résolution de noms"

msgid "Whether the machine can resolve the name of its Medulla server."
msgstr "Capacité de la machine à résoudre le nom de son serveur Medulla."

msgid "Critical system events"
msgstr "Événements système critiques"

msgid "Number of critical events recorded in the system log over the last 15 minutes. The window is part of the measure: a threshold with no period behind it means nothing."
msgstr "Nombre d'événements critiques enregistrés dans le journal système sur les 15 dernières minutes. La fenêtre fait partie de la mesure : un seuil sans période derrière lui ne veut rien dire."

msgid "Unexpected service stops"
msgstr "Arrêts de service inattendus"

msgid "Number of services that stopped unexpectedly over the last 15 minutes. Unlike the failed services probe, which reports the current state, this one counts services that went down during the window even when they were restarted right after."
msgstr "Nombre de services arrêtés de façon inattendue sur les 15 dernières minutes. À la différence de la sonde des services en échec, qui rapporte l'état courant, celle-ci compte les services tombés pendant la fenêtre même s'ils ont été redémarrés juste après."

msgid "Unexpected reboots"
msgstr "Redémarrages inattendus"

msgid "Number of reboots over the last 24 hours that were not preceded by a clean shutdown: power loss, kernel panic or forced power off."
msgstr "Nombre de redémarrages sur les 24 dernières heures qui n'ont pas été précédés d'un arrêt propre : coupure de courant, panique noyau ou extinction forcée."

msgid "Hardware errors"
msgstr "Erreurs matérielles"

msgid "Number of hardware errors reported by the system over the last 24 hours: memory, bus, processor or device faults."
msgstr "Nombre d'erreurs matérielles signalées par le système sur les 24 dernières heures : défauts de mémoire, de bus, de processeur ou de périphérique."

msgid "Filesystem errors"
msgstr "Erreurs de système de fichiers"

msgid "Number of filesystem errors reported by the system over the last 24 hours: corruption, inconsistency or a volume remounted read only."
msgstr "Nombre d'erreurs de système de fichiers signalées par le système sur les 24 dernières heures : corruption, incohérence ou volume remonté en lecture seule."

msgid "Modified system files"
msgstr "Fichiers système modifiés"

msgid "Number of files owned by a package whose content differs from what the package installed. The reference is the one kept by the package manager, so there is nothing to build and nothing to maintain on the machine."
msgstr "Nombre de fichiers appartenant à un paquet dont le contenu diffère de ce que le paquet a installé. La référence est celle que conserve le gestionnaire de paquets, il n'y a donc rien à constituer ni à maintenir sur la machine."

msgid "CPU load at @@value@@ % on @@machine@@ (threshold @@threshold@@ %)"
msgstr "Charge processeur à @@value@@ % sur @@machine@@ (seuil @@threshold@@ %)"

msgid "Memory used at @@value@@ % on @@machine@@ (threshold @@threshold@@ %)"
msgstr "Mémoire utilisée à @@value@@ % sur @@machine@@ (seuil @@threshold@@ %)"

msgid "Swap used at @@value@@ % on @@machine@@"
msgstr "Swap utilisé à @@value@@ % sur @@machine@@"

msgid "Disk space @@instance@@ at @@value@@ % on @@machine@@"
msgstr "Espace disque @@instance@@ à @@value@@ % sur @@machine@@"

msgid "Disk space critical @@instance@@ at @@value@@ % on @@machine@@"
msgstr "Espace disque critique @@instance@@ à @@value@@ % sur @@machine@@"

msgid "SMART status degraded on @@machine@@: @@value@@"
msgstr "État SMART dégradé sur @@machine@@ : @@value@@"

msgid "Agent silent on @@machine@@: nothing reported for @@value@@"
msgstr "Agent silencieux sur @@machine@@ : plus rien remonté depuis @@value@@"

msgid "@@value@@ failed service(s) on @@machine@@"
msgstr "@@value@@ service(s) en échec sur @@machine@@"

msgid "No antivirus running on @@machine@@"
msgstr "Aucun antivirus en fonctionnement sur @@machine@@"

msgid "Antivirus signatures @@value@@ days old on @@machine@@"
msgstr "Signatures antivirus vieilles de @@value@@ jours sur @@machine@@"

msgid "Firewall disabled on @@machine@@"
msgstr "Pare-feu désactivé sur @@machine@@"

msgid "System volume not encrypted on @@machine@@"
msgstr "Volume système non chiffré sur @@machine@@"

msgid "@@value@@ failed logons on @@machine@@"
msgstr "@@value@@ connexions en échec sur @@machine@@"

msgid "Reboot required on @@machine@@"
msgstr "Redémarrage requis sur @@machine@@"

msgid "Load average at @@value@@ % on @@machine@@ (threshold @@threshold@@ %)"
msgstr "Charge moyenne à @@value@@ % sur @@machine@@ (seuil @@threshold@@ %)"

msgid "Temperature at @@value@@ °C on @@machine@@ (threshold @@threshold@@ °C)"
msgstr "Température à @@value@@ °C sur @@machine@@ (seuil @@threshold@@ °C)"

msgid "Local administrators changed on @@machine@@ (now @@value@@)"
msgstr "Les administrateurs locaux ont changé sur @@machine@@ (désormais @@value@@)"

msgid "Name resolution failing on @@machine@@"
msgstr "Résolution de noms en échec sur @@machine@@"

msgid "@@value@@ critical system events on @@machine@@"
msgstr "@@value@@ événements système critiques sur @@machine@@"

msgid "@@value@@ services stopped unexpectedly on @@machine@@"
msgstr "@@value@@ services arrêtés de façon inattendue sur @@machine@@"

msgid "@@value@@ unexpected reboots on @@machine@@"
msgstr "@@value@@ redémarrages inattendus sur @@machine@@"

msgid "@@value@@ hardware errors on @@machine@@"
msgstr "@@value@@ erreurs matérielles sur @@machine@@"

msgid "@@value@@ filesystem errors on @@machine@@"
msgstr "@@value@@ erreurs de système de fichiers sur @@machine@@"

msgid "@@value@@ modified system files on @@machine@@"
msgstr "@@value@@ fichiers système modifiés sur @@machine@@"

#. Utilisee par pulse-xmpp-master-substitute, plugin reflex : message
#. par defaut d une alerte dont la condition ne porte pas de gabarit.
#. %s est le libelle de la condition, @@machine@@ est remplace par le
#. nom du poste et ne se traduit pas. Aucun PHP ne l emploie.
#, php-format
msgid "%s on @@machine@@"
msgstr "%s sur @@machine@@"

